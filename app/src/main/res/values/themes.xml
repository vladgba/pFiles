<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Suite theme (pUI): flat page-colored action bar, violet accent, follows the system dark mode. -->
    <style name="AppTheme" parent="Theme.P.Bar" />

    <!-- Screens that draw their own header (file panels, text editor). -->
    <style name="AppTheme.NoBar">
        <item name="android:windowActionBar">false</item>
        <item name="android:windowNoTitle">true</item>
        <!-- Selection bar: drawn over the top lines on the suite's accent-soft container. -->
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:actionModeBackground">@color/p_accent_soft</item>
    </style>

    <!-- Invisible entry activity: shows only a spinner while copying a file from another app. -->
    <style name="AppTheme.Translucent">
        <item name="android:windowActionBar">false</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:backgroundDimEnabled">false</item>
    </style>
</resources>
